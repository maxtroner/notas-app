{
  "name": "codenote-app",
  "version": "1.0.8",
  "description": "CodeNote - Notas inteligentes para desarrolladores.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always",
    "web": "npx http-server . -p 4173 -c-1"
  },
  "keywords": [
    "notas",
    "codenote",
    "desarrollador",
    "electron",
    "pwa"
  ],
  "author": "MaxtronerPC",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "http-server": "^14.1.1"
  },
  "build": {
    "appId": "com.maxtronerpc.codenote",
    "productName": "CodeNote",
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "icon": "assets/icon.png",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "manifest.webmanifest",
      "sw.js",
      "assets/**/*",
      "main.cjs",
      "preload.cjs"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "maxtroner",
        "repo": "notas-app",
        "releaseType": "release"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
